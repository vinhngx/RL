+def pixel_location_reward(
+    ground_truth: str, response: str
+) -> tuple[float, Optional[bool]]:
+    """Reward soft pixel-space localization while selecting on boxed count."""
+    try:
+        expected = json.loads(ground_truth)
+    except (json.JSONDecodeError, TypeError):
+        return boxed_numeric_reward(ground_truth, response)
+    if (
+        not isinstance(expected, dict)
+        or expected.get("coordinate_space") != "pixel"
+        or "points" not in expected
+    ):
+        return boxed_numeric_reward(ground_truth, response)
+
+    expected_points = [tuple(map(int, point)) for point in expected["points"]]
+    predicted_points = [
+        (int(x), int(y))
+        for x, y in re.findall(
+            r"\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*\)", response
+        )
+        if int(x) <= 999 and int(y) <= 999
+    ][:64]
+    edges = sorted(
+        (hypot(ex - px, ey - py), expected_index, predicted_index)
+        for expected_index, (ex, ey) in enumerate(expected_points)
+        for predicted_index, (px, py) in enumerate(predicted_points)
+    )
+    used_expected: set[int] = set()
+    used_predicted: set[int] = set()
+    soft_matches = 0.0
+    for distance, expected_index, predicted_index in edges:
+        if distance >= 150.0:
+            break
+        if expected_index in used_expected or predicted_index in used_predicted:
+            continue
+        used_expected.add(expected_index)
+        used_predicted.add(predicted_index)
+        soft_matches += 1.0 - distance / 150.0
+
+    if not expected_points and not predicted_points:
+        location_f1 = 1.0
+    elif not expected_points or not predicted_points:
+        location_f1 = 0.0
+    else:
+        location_f1 = 2.0 * soft_matches / (
+            len(expected_points) + len(predicted_points)
+        )
+
+    box_match = re.search(r"\\boxed\{(\d+)\}", response)
+    predicted_total = int(box_match.group(1)) if box_match else None
+    total_is_correct = predicted_total == int(expected["total"])
+    score = 0.6 * location_f1 + 0.4 * total_is_correct
+    return score, total_is_correct
+
