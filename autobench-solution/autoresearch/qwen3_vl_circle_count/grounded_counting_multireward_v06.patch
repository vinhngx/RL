+def grounded_counting_multireward(
+    ground_truth: str, response: str
+) -> tuple[float, Optional[bool]]:
+    """Paper-style point-grounded counting reward with five balanced terms.
+
+    The components are structured format, number of points, Hungarian-matched
+    spatial accuracy, point/count consistency, and exact boxed count.  Each
+    term lies in [0, 1] and contributes equally.
+    """
+    try:
+        expected = json.loads(ground_truth)
+    except (json.JSONDecodeError, TypeError):
+        return boxed_numeric_reward(ground_truth, response)
+    if (
+        not isinstance(expected, dict)
+        or expected.get("coordinate_space") != "pixel"
+        or "points" not in expected
+    ):
+        return boxed_numeric_reward(ground_truth, response)
+
+    expected_points = np.asarray(expected["points"], dtype=np.float64).reshape(-1, 2)
+    expected_total = int(expected["total"])
+    predicted_points = [
+        (int(x), int(y))
+        for x, y in re.findall(
+            r"<\s*(\d{1,3})\s*,\s*(\d{1,3})\s*>", response
+        )
+        if int(x) <= 999 and int(y) <= 999
+    ][:64]
+    predicted_array = np.asarray(predicted_points, dtype=np.float64).reshape(-1, 2)
+
+    answer_match = re.search(
+        r"<answer>\s*\\boxed\{(\d+)\}\s*</answer>", response, re.IGNORECASE
+    )
+    predicted_total = int(answer_match.group(1)) if answer_match else None
+    format_score = float(
+        re.fullmatch(
+            r"\s*<think>[\s\S]*</think>\s*"
+            r"<answer>\s*\\boxed\{\d+\}\s*</answer>\s*",
+            response,
+            re.IGNORECASE,
+        )
+        is not None
+    )
+
+    num_predicted = len(predicted_points)
+    if expected_total == 0:
+        num_points_score = float(num_predicted == 0)
+    else:
+        num_points_score = 1.0 - min(
+            1.0, abs(num_predicted - expected_total) / expected_total
+        )
+
+    if len(expected_points) == 0 and num_predicted == 0:
+        points_score = 1.0
+    elif len(expected_points) == 0 or num_predicted == 0:
+        points_score = 0.0
+    else:
+        distances = np.linalg.norm(
+            expected_points[:, None, :] - predicted_array[None, :, :], axis=2
+        )
+        expected_indices, predicted_indices = linear_sum_assignment(distances)
+        matched_scores = np.maximum(
+            0.0, 1.0 - distances[expected_indices, predicted_indices] / 800.0
+        )
+        points_score = float(np.mean(matched_scores))
+
+    consistency_score = float(
+        predicted_total is not None and predicted_total == num_predicted
+    )
+    count_score = float(predicted_total == expected_total)
+    score = float(
+        np.mean(
+            (
+                format_score,
+                num_points_score,
+                points_score,
+                consistency_score,
+                count_score,
+            )
+        )
+    )
+    return score, count_score == 1.0
+
