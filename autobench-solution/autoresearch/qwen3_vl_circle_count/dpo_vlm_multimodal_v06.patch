index 0000000..9b6196f
--- /dev/null
+++ b/nemo_rl/data/datasets/preference_datasets/circle_count.py
@@ -0,0 +1,30 @@
+import json
+from typing import Any
+
+from datasets import Dataset
+
+from nemo_rl.data.datasets.raw_dataset import RawDataset
+
+
+def parse_circle_count_preference(datum_dict: dict[str, Any]) -> dict[str, Any]:
+    """Decode one raw preference row without Arrow normalizing media parts."""
+    row = json.loads(datum_dict["raw"])
+    row["task_name"] = datum_dict["task_name"]
+    return row
+
+
+class CircleCountPreferenceDataset(RawDataset):
+    """Preference JSONL that preserves heterogeneous image/text content."""
+
+    preprocessor = staticmethod(parse_circle_count_preference)
+
+    def __init__(self, data_path: str, **kwargs: Any):
+        self.task_name = "circle-count-preference"
+        with open(data_path) as source:
+            raw_lines = list(source)
+        self.dataset = Dataset.from_dict(
+            {
+                "raw": raw_lines,
+                "task_name": [self.task_name] * len(raw_lines),
+            }
+        )
