+def ordinal_count_reward(
+    ground_truth: str, response: str
+) -> tuple[float, Optional[bool]]:
+    """Reward six monotone count thresholds and the strict boxed total."""
+    try:
+        expected = json.loads(ground_truth)
+    except (json.JSONDecodeError, TypeError):
+        return boxed_numeric_reward(ground_truth, response)
+    if not isinstance(expected, dict) or expected.get("kind") != "ordinal_count":
+        return boxed_numeric_reward(ground_truth, response)
+
+    predicted_thresholds = {
+        f"ge{threshold}": int(value)
+        for threshold, value in re.findall(
+            r"\bGE(5|6|7|8|9|10)\s*[:=]\s*([01])\b", response, re.IGNORECASE
+        )
+    }
+    threshold_names = tuple(f"ge{threshold}" for threshold in range(5, 11))
+    correct_thresholds = sum(
+        predicted_thresholds.get(name) == int(expected[name])
+        for name in threshold_names
+    )
+    box_match = re.search(r"\\boxed\{(\d+)\}", response)
+    predicted_total = int(box_match.group(1)) if box_match else None
+    total_is_correct = predicted_total == int(expected["total"])
+    thresholds_are_correct = correct_thresholds == len(threshold_names)
+    score = 0.5 * correct_thresholds / len(threshold_names) + 0.5 * total_is_correct
+    return score, total_is_correct and thresholds_are_correct
+
