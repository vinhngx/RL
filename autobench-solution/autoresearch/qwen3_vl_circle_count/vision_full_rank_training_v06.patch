+def freeze_parameters_outside_patterns(
+    model: torch.nn.Module, patterns: list[str]
+) -> tuple[int, int]:
+    """Freeze parameters whose fully qualified names match none of ``patterns``."""
+    trainable = 0
+    frozen = 0
+    for name, param in model.named_parameters():
+        should_train = any(fnmatchcase(name, pattern) for pattern in patterns)
+        param.requires_grad_(should_train)
+        if should_train:
+            trainable += param.numel()
+        else:
+            frozen += param.numel()
+    if trainable == 0:
+        raise ValueError(
+            f"trainable_param_patterns matched no parameters: {patterns}"
+        )
+    return trainable, frozen
+
