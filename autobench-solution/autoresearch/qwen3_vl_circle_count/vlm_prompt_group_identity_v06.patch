+def _dataset_prompt_group_ids(
+    repeated_batch: BatchedDataDict[DatumSpec], num_generations: int
+) -> torch.Tensor:
+    """Identify VLM prompt groups by dataset example, including image identity.
+
+    Token-only prompt equality conflates different images that ask the same
+    textual question. ``idx`` is repeated by ``repeat_interleave`` and remains
+    attached through rollout and dynamic-sampling selection.
+    """
+    ids = torch.as_tensor(repeated_batch["idx"], dtype=torch.long)
+    _, counts = torch.unique(ids, return_counts=True)
+    if counts.numel() == 0 or not torch.all(counts == num_generations):
+        raise ValueError(
+            "Each VLM prompt idx must identify exactly "
+            f"{num_generations} contiguous rollouts; counts={counts.tolist()}"
+        )
+    print(
+        f"  ✓ VLM prompt identity: {counts.numel()} image groups x "
+        f"{num_generations} rollouts",
+        flush=True,
+    )
+    return ids.unsqueeze(-1)
+
+
