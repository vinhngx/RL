@@ -690,6 +721,64 @@ def counterfactual_localization_loss(
     }
 
 
+def circle_color_alignment_loss(
+    *,
+    visual_tokens: list[torch.Tensor],
+    grid_shapes: list[tuple[int, int]],
+    annotations: torch.Tensor,
+    sample_mask: torch.Tensor,
+    color_vectors: torch.Tensor,
+    temperature: float,
+) -> tuple[torch.Tensor, dict[str, float]]:
+    """Classify every known circle center against frozen color-word vectors."""
+    if len(visual_tokens) != len(grid_shapes) or annotations.shape[0] != len(
+        visual_tokens
+    ):
+        raise ValueError("circle color metadata shape mismatch")
+    if temperature <= 0:
+        raise ValueError("circle color temperature must be positive")
+    normalized_colors = torch.nn.functional.normalize(
+        color_vectors.float(), dim=-1
+    )
+    losses = []
+    correct = []
+    for sample_index, (tokens, (height, width)) in enumerate(
+        zip(visual_tokens, grid_shapes, strict=True)
+    ):
+        if tokens.shape[0] != height * width:
+            raise ValueError("visual token count does not match its grid")
+        if sample_mask[sample_index] <= 0:
+            continue
+        valid = annotations[sample_index, :, 2] >= 0
+        sample_annotations = annotations[sample_index, valid]
+        grid_x = (sample_annotations[:, 0] * width).long().clamp(max=width - 1)
+        grid_y = (sample_annotations[:, 1] * height).long().clamp(max=height - 1)
+        labels = sample_annotations[:, 2].long()
+        selected = tokens[grid_y * width + grid_x]
+        logits = (
+            torch.nn.functional.normalize(selected.float(), dim=-1)
+            @ normalized_colors.T
+        ) / temperature
+        losses.append(
+            torch.nn.functional.cross_entropy(logits, labels, reduction="sum")
+        )
+        correct.append((logits.argmax(-1) == labels).sum())
+    circle_count = sum(
+        int((annotations[index, :, 2] >= 0).sum())
+        for index in range(len(visual_tokens))
+        if sample_mask[index] > 0
+    )
+    if circle_count == 0:
+        raise ValueError("circle color batch contains no valid annotations")
+    color_loss = torch.stack(losses).sum() / circle_count
+    color_accuracy = torch.stack(correct).sum().float() / circle_count
+    return color_loss, {
+        "circle_color_loss": color_loss.item(),
+        "circle_color_accuracy": color_accuracy.item(),
+        "circle_color_count": float(circle_count),
+    }
+
+
