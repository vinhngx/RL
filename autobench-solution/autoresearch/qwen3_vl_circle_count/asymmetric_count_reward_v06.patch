+def boxed_numeric_asymmetric_reward(
+    ground_truth: str, response: str
+) -> tuple[float, Optional[bool]]:
+    """Reward exact counts and penalize undercounts more than overcounts."""
+    match = re.search(r"\\boxed\{(\d+)\}", response)
+    if not match:
+        return -0.5, False
+    predicted = int(match.group(1))
+    expected = int(ground_truth)
+    if predicted == expected:
+        return 1.0, True
+    if predicted < expected:
+        return -0.5, False
+    return 0.0, False
+
