+class RLZVPAdvantageEstimator:
+    """GRPO plus entropy-shaped credit for zero-variance prompt groups.
+
+    This follows Eq. 5 of Le et al., "No Prompt Left Behind" (ICLR 2026).
+    ``token_entropies`` may use a truncated top-k vocabulary distribution to
+    avoid materializing full-vocabulary logits on the driver.
+    """
+
+    def __init__(self, estimator_config: dict, loss_config: dict):
+        self.use_leave_one_out_baseline = estimator_config[
+            "use_leave_one_out_baseline"
+        ]
+        self.normalize_rewards = estimator_config["normalize_rewards"]
+        self.alpha = float(estimator_config.get("alpha", 0.1))
+        self.entropy_top_k = int(estimator_config.get("entropy_top_k", 64))
+        if self.alpha <= 0:
+            raise ValueError("RL-ZVP alpha must be positive")
+        if self.entropy_top_k <= 1:
+            raise ValueError("RL-ZVP entropy_top_k must exceed one")
+
+    def compute_advantage(
+        self, prompt_ids, rewards, mask, token_entropies=None, **kwargs
+    ):
+        if token_entropies is None:
+            raise ValueError("RL-ZVP requires token_entropies")
+        if token_entropies.shape != mask.shape:
+            raise ValueError(
+                "RL-ZVP token entropy shape must match the response mask"
+            )
+
+        baseline, std = calculate_baseline_and_std_per_prompt(
+            prompt_ids,
+            rewards,
+            torch.ones_like(rewards),
+            leave_one_out_baseline=self.use_leave_one_out_baseline,
+        )
+        response_advantages = (rewards - baseline).unsqueeze(-1)
+        if self.normalize_rewards:
+            non_zero_std = std > 0
+            response_advantages[non_zero_std] = response_advantages[non_zero_std] / (
+                std.unsqueeze(-1)[non_zero_std] + 1e-6
+            )
+        advantages = response_advantages.expand(mask.shape).clone()
+
+        zero_variance = std <= 0
+        if zero_variance.any():
+            entropies = token_entropies.to(
+                device=advantages.device, dtype=advantages.dtype
+            ).detach()
+            valid_entropies = entropies.masked_fill(~mask.bool(), float("-inf"))
+            max_entropy = valid_entropies.max(dim=-1).values
+            max_entropy = torch.where(
+                torch.isfinite(max_entropy), max_entropy, torch.zeros_like(max_entropy)
+            )
+            positive = zero_variance & (rewards > 0)
+            negative = zero_variance & ~positive
+            advantages[positive] = self.alpha * entropies[positive]
+            advantages[negative] = -self.alpha * (
+                max_entropy[negative].unsqueeze(-1) - entropies[negative]
+            )
+
+        return advantages * mask
+
+
