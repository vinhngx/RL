@@ -179,5 +179,29 @@ class GRPOConfig(TypedDict):
     # Advantage estimator configuration (grpo or reinforce_plus_plus)
     adv_estimator: NotRequired[AdvEstimatorConfig]
+    # Optional generated-token IDs that receive policy-gradient credit. When
+    # omitted, standard GRPO trains every generated assistant token.
+    perception_token_ids: NotRequired[list[int]]
+
+
+def _set_grpo_token_loss_mask(
+    message: dict[str, Any], perception_token_ids: Optional[list[int]] = None
+) -> None:
+    """Mark generated assistant tokens selected for policy-gradient credit."""
+    token_ids = message["token_ids"]
+    if message["role"] != "assistant":
+        message["token_loss_mask"] = torch.zeros_like(token_ids)
+    elif not perception_token_ids:
+        message["token_loss_mask"] = torch.ones_like(token_ids)
+    else:
+        token_loss_mask = torch.zeros_like(token_ids)
+        for token_id in perception_token_ids:
+            token_loss_mask |= token_ids == token_id
+        message["token_loss_mask"] = token_loss_mask
+
+    if "generation_logprobs" not in message:
+        message["generation_logprobs"] = torch.zeros_like(
+            token_ids, dtype=torch.float32
+        )
 
 
