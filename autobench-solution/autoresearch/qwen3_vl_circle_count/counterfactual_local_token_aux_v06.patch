+def counterfactual_localization_loss(
+    *,
+    visual_tokens: list[torch.Tensor],
+    grid_shapes: list[tuple[int, int]],
+    centers: torch.Tensor,
+    sample_mask: torch.Tensor,
+    global_valid_seqs: torch.Tensor,
+    temperature: float,
+    sigma: float,
+) -> tuple[torch.Tensor, dict[str, float]]:
+    """Localize the sole changed circle using paired visual-token deltas."""
+    if len(visual_tokens) % 4 != 0:
+        raise ValueError("counterfactual local batches must contain groups of 4")
+    if len(grid_shapes) != len(visual_tokens) or centers.shape != (
+        len(visual_tokens),
+        2,
+    ):
+        raise ValueError("counterfactual local metadata shape mismatch")
+    if temperature <= 0 or sigma <= 0:
+        raise ValueError("temperature and sigma must be positive")
+    group_losses = []
+    group_hits = []
+    group_masks = []
+    for start in range(0, len(visual_tokens), 4):
+        shapes = grid_shapes[start : start + 4]
+        if any(shape != shapes[0] for shape in shapes[1:]):
+            raise ValueError("counterfactual visual grids differ within a pair")
+        pair_centers = centers[start : start + 4]
+        if not torch.allclose(pair_centers, pair_centers[:1].expand_as(pair_centers)):
+            raise ValueError("counterfactual centers differ within a pair")
+        lower = (visual_tokens[start] + visual_tokens[start + 1]) / 2
+        upper = (visual_tokens[start + 2] + visual_tokens[start + 3]) / 2
+        token_delta = upper.float() - lower.float()
+        height, width = shapes[0]
+        if token_delta.shape[0] != height * width:
+            raise ValueError("visual token count does not match its grid")
+        scores = token_delta.square().mean(-1) / temperature
+        y = torch.arange(height, device=scores.device, dtype=scores.dtype) + 0.5
+        x = torch.arange(width, device=scores.device, dtype=scores.dtype) + 0.5
+        yy, xx = torch.meshgrid(y, x, indexing="ij")
+        center_x = pair_centers[0, 0].to(scores.dtype) * width
+        center_y = pair_centers[0, 1].to(scores.dtype) * height
+        squared_distance = (xx - center_x).square() + (yy - center_y).square()
+        target = torch.softmax(
+            -squared_distance.flatten() / (2 * sigma * sigma), dim=0
+        )
+        group_losses.append(-(target * torch.log_softmax(scores, dim=0)).sum())
+        nearest = squared_distance.flatten().argmin()
+        group_hits.append((scores.argmax() == nearest).float())
+        group_masks.append(sample_mask[start : start + 4].min())
+    losses = torch.stack(group_losses)
+    hits = torch.stack(group_hits)
+    masks = torch.stack(group_masks)
+    global_groups = (global_valid_seqs / 4).clamp(min=1)
+    aux_loss = (losses * masks).sum() / global_groups
+    return aux_loss, {
+        "counterfactual_local_loss": aux_loss.item(),
+        "counterfactual_local_top1": ((hits * masks).sum() / global_groups).item(),
+    }
+
