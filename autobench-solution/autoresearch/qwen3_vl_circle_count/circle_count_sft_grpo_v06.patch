diff --git a/nemo_rl/data/datasets/response_datasets/circle_count.py b/nemo_rl/data/datasets/response_datasets/circle_count.py
new file mode 100644
--- /dev/null
+++ b/nemo_rl/data/datasets/response_datasets/circle_count.py
@@ -0,0 +1,73 @@
+import json
+from typing import Any
+
+from datasets import Dataset
+
+from nemo_rl.data.datasets.raw_dataset import RawDataset
+
+
+def format_circle_count_dataset(datum_dict: dict[str, Any]) -> dict[str, Any]:
+    """Format a raw Gym circle-count row for VLM rollout training."""
+    row = json.loads(datum_dict["raw"])
+    image_url = None
+    question_text = ""
+    for message in row["responses_create_params"]["input"]:
+        if message["role"] != "user":
+            continue
+        for content in message["content"]:
+            if content["type"] == "input_image":
+                image_url = content["image_url"]
+            elif content["type"] == "input_text":
+                question_text = content["text"]
+
+    expected_count = sum(
+        circle["color"] == row["target_color"] for circle in row["circles"]
+    )
+    return {
+        "messages": [
+            {
+                "role": "user",
+                "content": [
+                    {"type": "image", "image": image_url},
+                    {"type": "text", "text": question_text},
+                ],
+            },
+            {"role": "assistant", "content": str(expected_count)},
+        ],
+        "task_name": datum_dict["task_name"],
+    }
+
+
+class CircleCountDataset(RawDataset):
+    """Raw Gym circle-count JSONL used by the native VLM reward environment."""
+
+    def __init__(self, data_path: str, **kwargs: Any):
+        self.task_name = "circle-count"
+        with open(data_path) as source:
+            raw_lines = list(source)
+        self.dataset = Dataset.from_dict(
+            {
+                "raw": raw_lines,
+                "task_name": [self.task_name] * len(raw_lines),
+            }
+        )
+
+
+class CircleCountSFTDataset(RawDataset):
+    """Keep mixed string/list message content as raw JSON until processing."""
+
+    def __init__(self, data_path: str, **kwargs: Any):
+        self.task_name = "circle-count-sft"
+        with open(data_path) as source:
+            raw_lines = list(source)
+        self.dataset = Dataset.from_dict(
+            {
+                "raw": raw_lines,
+                "task_name": [self.task_name] * len(raw_lines),
+            }
+        )
+
+
+def format_circle_count_sft_dataset(datum_dict: dict[str, Any]) -> dict[str, Any]:
+    row = json.loads(datum_dict["raw"])
+    return {"messages": row["messages"], "task_name": datum_dict["task_name"]}
