diff --git a/nemo_rl/data/datasets/response_datasets/circle_count.py b/nemo_rl/data/datasets/response_datasets/circle_count.py
new file mode 100644
--- /dev/null
+++ b/nemo_rl/data/datasets/response_datasets/circle_count.py
@@ -0,0 +1,26 @@
+import json
+from typing import Any
+
+from datasets import Dataset
+
+from nemo_rl.data.datasets.raw_dataset import RawDataset
+
+
+class CircleCountSFTDataset(RawDataset):
+    """Keep mixed string/list message content as raw JSON until processing."""
+
+    def __init__(self, data_path: str, **kwargs: Any):
+        self.task_name = "circle-count-sft"
+        with open(data_path) as source:
+            raw_lines = list(source)
+        self.dataset = Dataset.from_dict(
+            {
+                "raw": raw_lines,
+                "task_name": [self.task_name] * len(raw_lines),
+            }
+        )
+
+
+def format_circle_count_sft_dataset(datum_dict: dict[str, Any]) -> dict[str, Any]:
+    row = json.loads(datum_dict["raw"])
+    return {"messages": row["messages"], "task_name": datum_dict["task_name"]}
