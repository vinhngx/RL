+def _make_vppo_augmented_multimodal_data(
+    multimodal_data: dict[str, Any], black_probability: float, seed: int
+) -> dict[str, Any]:
+    """Zero random Qwen vision-patch rows for VPPO sensitivity scoring."""
+    if not 0.0 < black_probability < 1.0:
+        raise ValueError("vppo black_probability must be in (0, 1)")
+    augmented = {}
+    for key, value in multimodal_data.items():
+        if key != "pixel_values":
+            augmented[key] = value
+            continue
+        if not isinstance(value, PackedTensor):
+            raise TypeError("vppo expects pixel_values to be a PackedTensor")
+        tensors = []
+        for index, tensor in enumerate(value.tensors):
+            if tensor is None:
+                tensors.append(None)
+                continue
+            masked = tensor.clone()
+            generator = torch.Generator(device=masked.device)
+            generator.manual_seed(seed + index)
+            patch_count = masked.shape[value.dim_to_pack]
+            patch_mask = torch.rand(
+                patch_count, generator=generator, device=masked.device
+            ) < black_probability
+            view_shape = [1] * masked.ndim
+            view_shape[value.dim_to_pack] = patch_count
+            masked.masked_fill_(patch_mask.view(view_shape), 0)
+            tensors.append(masked)
+        augmented[key] = PackedTensor(tensors, value.dim_to_pack)
+    if "pixel_values" not in augmented:
+        raise ValueError("vppo requires image pixel_values")
+    return augmented
+
+
+def _apply_vppo_perception_credit(
+    train_data: BatchedDataDict[ClippedPGLossDataDict],
+    augmented_logprobs: torch.Tensor,
+    config: VPPOPerceptionConfig,
+) -> dict[str, float]:
+    """Select visually sensitive response tokens and optionally shape advantage."""
+    top_p = float(config.get("top_p", 0.2))
+    if not 0.0 < top_p <= 1.0:
+        raise ValueError("vppo top_p must be in (0, 1]")
+
+    response_mask = train_data["token_mask"].bool()
+    original_logprobs = train_data["prev_logprobs"]
+    logprob_difference = (augmented_logprobs - original_logprobs).clamp(-20, 20)
+    perception = (logprob_difference.exp() - logprob_difference - 1).clamp(0, 10)
+    selected = torch.zeros_like(response_mask)
+    for row in range(response_mask.shape[0]):
+        valid_indices = response_mask[row].nonzero(as_tuple=False).flatten()
+        if valid_indices.numel() == 0:
+            continue
+        keep = max(1, math.ceil(valid_indices.numel() * top_p))
+        scores = perception[row, valid_indices]
+        chosen = valid_indices[torch.topk(scores, k=keep).indices]
+        selected[row, chosen] = True
+    train_data["token_mask"] = selected.to(train_data["token_mask"].dtype)
+
+    valid_counts = response_mask.sum(dim=1).clamp(min=1)
+    sensitivity = (perception * response_mask).sum(dim=1) / valid_counts
+    if config.get("advantage_shaping", True) and sensitivity.numel() > 1:
+        score_min = sensitivity.min()
+        score_max = sensitivity.max()
+        if (score_max - score_min).item() > 1e-8:
+            normalized = (sensitivity - score_min) / (score_max - score_min)
+            scaling_min = float(config.get("advantage_scaling_min", 0.8))
+            mean_normalized = normalized.mean().clamp(min=1e-8)
+            scaling_max = scaling_min + (1.0 - scaling_min) / mean_normalized
+            scaling = scaling_min + normalized * (scaling_max - scaling_min)
+            train_data["advantages"] *= scaling.unsqueeze(1)
+
+    selected_scores = perception[selected]
+    rejected_scores = perception[response_mask & ~selected]
+    return {
+        "vppo/selected_token_fraction": float(selected.sum() / response_mask.sum()),
+        "vppo/perception_selected_mean": float(selected_scores.mean()),
+        "vppo/perception_rejected_mean": float(rejected_scores.mean()),
+        "vppo/trajectory_sensitivity_mean": float(sensitivity.mean()),
+    }
+
