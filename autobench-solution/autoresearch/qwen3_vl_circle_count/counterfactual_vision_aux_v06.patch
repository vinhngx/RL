+def counterfactual_vision_direction_loss(
+    *,
+    pooled: torch.Tensor,
+    input_ids: torch.Tensor,
+    token_mask: torch.Tensor,
+    sample_mask: torch.Tensor,
+    count_direction_weights: torch.Tensor,
+    global_valid_seqs: torch.Tensor,
+    margin: float,
+    temperature: float,
+) -> tuple[torch.Tensor, dict[str, float]]:
+    """Align each +1 image delta with its frozen decoder digit direction."""
+    if pooled.shape[0] % 4 != 0:
+        raise ValueError("counterfactual vision batches must contain groups of 4")
+    if temperature <= 0:
+        raise ValueError("counterfactual vision temperature must be positive")
+    group_losses = []
+    group_cosines = []
+    group_masks = []
+    for start in range(0, pooled.shape[0], 4):
+        digit_ids = []
+        for row in (start, start + 2):
+            selected = input_ids[row][
+                token_mask[row].bool()
+                & (input_ids[row] >= 15)
+                & (input_ids[row] <= 24)
+            ]
+            if selected.numel() == 0:
+                raise ValueError("chosen response has no digit token")
+            digit_ids.append(selected[0])
+        lower = (pooled[start] + pooled[start + 1]) / 2
+        upper = (pooled[start + 2] + pooled[start + 3]) / 2
+        visual_delta = upper - lower
+        count_direction = (
+            count_direction_weights[digit_ids[1]]
+            - count_direction_weights[digit_ids[0]]
+        ).detach()
+        cosine = torch.nn.functional.cosine_similarity(
+            visual_delta.float(), count_direction.float(), dim=0
+        )
+        group_cosines.append(cosine)
+        group_losses.append(
+            torch.nn.functional.softplus((margin - cosine) / temperature)
+        )
+        group_masks.append(sample_mask[start : start + 4].min())
+    losses = torch.stack(group_losses)
+    cosines = torch.stack(group_cosines)
+    masks = torch.stack(group_masks)
+    global_groups = (global_valid_seqs / 4).clamp(min=1)
+    aux_loss = (losses * masks).sum() / global_groups
+    return aux_loss, {
+        "counterfactual_vision_loss": aux_loss.item(),
+        "counterfactual_vision_cosine": ((cosines * masks).sum() / global_groups).item(),
+        "counterfactual_vision_positive": (
+            ((cosines > 0).float() * masks).sum() / global_groups
+        ).item(),
+    }
+
+
