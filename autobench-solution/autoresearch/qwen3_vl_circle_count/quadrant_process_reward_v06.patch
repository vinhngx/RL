+import json
 import re
 from typing import Callable, Optional
@@ -43,6 +44,33 @@ def boxed_numeric_reward(
     return 0.0, False
 
 
+def quadrant_process_reward(
+    ground_truth: str, response: str
+) -> tuple[float, Optional[bool]]:
+    """Reward four correct quadrant subtotals and the strict boxed total."""
+    try:
+        expected = json.loads(ground_truth)
+    except (json.JSONDecodeError, TypeError):
+        return boxed_numeric_reward(ground_truth, response)
+    if not isinstance(expected, dict):
+        return boxed_numeric_reward(ground_truth, response)
+
+    fields = {}
+    for name in ("tl", "tr", "bl", "br"):
+        match = re.search(rf"\b{name}\b[^\d\n]{{0,24}}(\d+)", response, re.IGNORECASE)
+        if match:
+            fields[name] = int(match.group(1))
+    box_match = re.search(r"\\boxed\{(\d+)\}", response)
+    predicted_total = int(box_match.group(1)) if box_match else None
+
+    correct_subtotals = sum(
+        fields.get(name) == int(expected[name]) for name in ("tl", "tr", "bl", "br")
+    )
+    total_is_correct = predicted_total == int(expected["total"])
+    score = 0.125 * correct_subtotals + 0.5 * total_is_correct
+    return score, total_is_correct and correct_subtotals == 4
+
